    "reminder.denied.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die Benachrichtigungen für DevLingo in den Einstellungen, um die tägliche Erinnerung zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications for DevLingo in Settings to get your daily streak reminder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones de DevLingo en Ajustes para recibir tu recordatorio diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les notifications de DevLingo dans Réglages pour recevoir ton rappel quotidien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche di DevLingo nelle Impostazioni per ricevere il promemoria giornaliero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações do DevLingo nos Ajustes para receber o lembrete diário da sequência."
          }
        }
      }
    },
