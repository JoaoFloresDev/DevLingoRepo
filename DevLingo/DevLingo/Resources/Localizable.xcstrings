    "reminder.primer.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevLingo kann dir eine Benachrichtigung pro Tag senden, damit deine Serie nie reißt. Als Nächstes fragt iOS nach deiner Erlaubnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DevLingo can send you one notification a day so your streak never breaks. iOS will ask for your permission next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DevLingo puede enviarte una notificación al día para que tu racha nunca se rompa. A continuación, iOS te pedirá permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DevLingo peut t'envoyer une notification par jour pour que ta série ne s'arrête jamais. iOS te demandera ensuite ton autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DevLingo può inviarti una notifica al giorno così la tua serie non si interrompe mai. Subito dopo, iOS ti chiederà il permesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DevLingo pode enviar uma notificação por dia para sua sequência nunca quebrar. Em seguida, o iOS vai pedir sua permissão."
          }
        }
      }
    },
